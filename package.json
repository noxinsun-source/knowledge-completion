{
  "name": "knowledge-completion",
  "version": "1.0.0",
  "description": "Persistent, evidence-backed knowledge completion with an interactive multi-granularity graph.",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "agent": "node --experimental-strip-types packages/knowledge-agent/src/cli.ts",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --port 4318",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:engine && npm run test:agent && npm run test:ui && npm run build && node --test tests/rendered-html.test.mjs",
    "test:engine": "node --experimental-strip-types --test tests/knowledge-engine.test.ts",
    "test:agent": "node --experimental-strip-types --test tests/knowledge-agent.test.ts tests/agent-run-service.test.ts tests/agent-cli.test.mjs tests/plugin-submit-run.test.mjs tests/skill-integrations.test.mjs",
    "test:ui": "node --test tests/knowledge-network-ui.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
