# Optional: make POST /api/runs and `npm run agent` call a real OpenAI-compatible
# model for bounded semantic expansion. Without these, the Run API uses the
# offline `heuristic-offline-v1` provider (note-evidence only, never fabricates
# out-of-note knowledge). Copy to .env.local for local dev, or set as Worker
# secrets/variables for production.
KNOWLEDGE_AGENT_BASE_URL=https://api.deepseek.com
KNOWLEDGE_AGENT_MODEL=deepseek-chat
KNOWLEDGE_AGENT_API_KEY=
